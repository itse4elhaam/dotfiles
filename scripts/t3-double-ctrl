#!/usr/bin/python3
"""Double-tap Ctrl to start or stop T3 Code voice dictation on X11.

This observes X11 input without grabbing keys. On a double tap while a
T3 Code window is focused it sends the existing Ctrl+Shift+D shortcut.
"""

DICTATION_KEYS = ("Control_L", "Shift_L", "d")
CONTROL_KEYS = ("Control_L", "Control_R")
T3_WINDOW_CLASSES = {"t3code", "com.t3tools.t3code"}
BUTTON_OFFSET = 256  # keeps mouse-button codes apart from keycodes


class DoubleTap:
    """Report the second of two clean taps of one key.

    A tap is a press and release within 250 ms with nothing else held or
    pressed, so Ctrl+C, Ctrl+click and a held Ctrl never count. The second tap
    must end within 400 ms of the first. Timestamps are X server milliseconds.
    """

    def __init__(self, keycode, held=()):
        self.keycode = keycode
        self.held = set(held)
        self.pressed_at = None
        self.first_tap = None
        self.last_trigger = None

    def feed(self, pressed, keycode, timestamp):
        elapsed = lambda start: (timestamp - start) & 0xFFFFFFFF
        if keycode != self.keycode:
            self.first_tap = self.pressed_at = None
            if pressed:
                self.held.add(keycode)
            else:
                self.held.discard(keycode)
            return False
        if pressed:
            if keycode not in self.held:
                self.pressed_at = timestamp if not self.held else None
            self.held.add(keycode)
            return False
        self.held.discard(keycode)
        started, self.pressed_at = self.pressed_at, None
        if started is None or elapsed(started) > 250 or self.held:
            self.first_tap = None
            return False
        if self.last_trigger is not None and elapsed(self.last_trigger) < 850:
            self.first_tap = None
            return False
        if self.first_tap is not None and elapsed(self.first_tap) <= 400:
            self.first_tap = None
            self.last_trigger = timestamp
            return True
        self.first_tap = timestamp
        return False


class DoubleCtrl:
    """Two taps of the same Ctrl key. Each detector sees the other Ctrl as another key."""

    def __init__(self, keycodes, held=()):
        self.detectors = [DoubleTap(keycode, held) for keycode in keycodes]

    def feed(self, pressed, keycode, timestamp):
        # Feed every detector; a short-circuit would leave one with stale state.
        return any([detector.feed(pressed, keycode, timestamp) for detector in self.detectors])


def is_t3_window(window_class):
    return bool(window_class) and any(name.lower() in T3_WINDOW_CLASSES for name in window_class)


def main():
    from Xlib import X, XK, display, error
    from Xlib.ext import record, xtest
    from Xlib.protocol import rq

    # RECORD blocks its connection, so focus checks and the key go through another.
    listener, control = display.Display(), display.Display()
    if not listener.has_extension("RECORD") or not control.has_extension("XTEST"):
        raise SystemExit("X11 RECORD and XTEST extensions are required")
    keycode_of = lambda name: control.keysym_to_keycode(XK.string_to_keysym(name))
    dictation_keys = [keycode_of(name) for name in DICTATION_KEYS]
    controls = [code for code in map(keycode_of, CONTROL_KEYS) if code]
    if not all(dictation_keys) or not controls:
        raise SystemExit("The keymap lacks a key needed for Ctrl+Shift+D")
    keymap = control.query_keymap()
    held = [i for i in range(256) if keymap[i // 8] & (1 << (i % 8))]
    detector = DoubleCtrl(controls, held)
    root = control.screen().root
    active_window = control.intern_atom("_NET_ACTIVE_WINDOW")

    def t3_is_focused():
        try:
            active = root.get_full_property(active_window, X.AnyPropertyType)
            if active is None or not active.value or not active.value[0]:
                return False
            return is_t3_window(control.create_resource_object("window", active.value[0]).get_wm_class())
        except error.XError:
            return False  # the window closed between the two requests

    def receive(reply):
        if reply.category != record.FromServer or reply.client_swapped or not reply.data:
            return
        data = reply.data
        while data:
            event, data = rq.EventField(None).parse_binary_value(data, listener.display, None, None)
            if event.type not in (X.KeyPress, X.KeyRelease, X.ButtonPress, X.ButtonRelease):
                continue
            # Mouse buttons cancel a partial double tap, just like another key.
            button = event.type in (X.ButtonPress, X.ButtonRelease)
            code = event.detail + (BUTTON_OFFSET if button else 0)
            if detector.feed(event.type in (X.KeyPress, X.ButtonPress), code, event.time) and t3_is_focused():
                for key in dictation_keys:
                    xtest.fake_input(control, X.KeyPress, key)
                for key in reversed(dictation_keys):
                    xtest.fake_input(control, X.KeyRelease, key)
                control.sync()
                print("Double Ctrl: sent the dictation key to T3 Code", flush=True)

    context = listener.record_create_context(0, [record.AllClients], [{
        "core_requests": (0, 0), "core_replies": (0, 0),
        "ext_requests": (0, 0, 0, 0), "ext_replies": (0, 0, 0, 0),
        "delivered_events": (0, 0), "device_events": (X.KeyPress, X.ButtonRelease),
        "errors": (0, 0), "client_started": False, "client_died": False,
    }])
    print("Listening for two taps of Ctrl within 400 ms", flush=True)
    try:
        listener.record_enable_context(context, receive)
    finally:
        listener.record_free_context(context)
        listener.close()
        control.close()


if __name__ == "__main__":
    main()
