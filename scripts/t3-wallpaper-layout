#!/usr/bin/env python3
"""Apply empty-thread wallpaper and normal header styling to installed themes."""

import argparse
from datetime import datetime
import json
from pathlib import Path
import re
import shutil


def compact_css(css):
    # Preserve quoted strings, including embedded images and attribute selectors.
    tokens = re.split(r'''(/\*[\s\S]*?\*/|"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')''', css)
    for index in range(1, len(tokens), 2):
        if tokens[index].startswith("/*"):
            tokens[index] = " "
    for index in range(0, len(tokens), 2):
        value = re.sub(r"/\*[\s\S]*?\*/", "", tokens[index])
        value = re.sub(r"\s+", " ", value)
        tokens[index] = re.sub(r"\s*([{};,])\s*", r"\1", value).replace(" !important", "!important")
    result = "".join(tokens).strip()
    return re.sub(r'([~|^$*]?=)"([a-zA-Z_][a-zA-Z0-9_-]*)"\]', r'\1\2]', result)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--themes-dir", type=Path, default=Path.home() / ".t3/userdata/themes")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    rules_path = Path(__file__).resolve().parent.parent / ".config/t3code/wallpaper-layout.css"
    rules = compact_css(rules_path.read_text())
    marker = "/* t3-wallpaper-layout */"
    pending = []
    for path in sorted(args.themes_dir.glob("*.json")):
        theme = json.loads(path.read_text())
        css = theme.get("css", "")
        if "--td-wallpaper:" not in css or path.stem == "zen-mode":
            continue
        css = css.split(marker, 1)[0]
        # Replace old header styling with the shared rule below the marker.
        css = re.sub(r'\.dark \[data-chat-header\]\s*\{[^{}]*\}', "", css)
        updated = compact_css(css) + "\n" + marker + "\n" + rules + "\n"
        if len(updated) > 50_000:
            raise SystemExit(f"{path.name}: CSS exceeds T3's 50,000-character limit")
        if updated == theme["css"]:
            continue
        theme["css"] = updated
        pending.append((path, theme))
    if pending and not args.dry_run:
        backup = args.themes_dir.parent / "theme-backups" / datetime.now().strftime("wallpaper-layout-%Y%m%d-%H%M%S-%f")
        backup.mkdir(parents=True)
        for path, theme in pending:
            shutil.copy2(path, backup / path.name)
            temporary = path.with_suffix(".json.tmp")
            temporary.write_text(json.dumps(theme, indent=2) + "\n")
            temporary.replace(path)
        print(f"Backups: {backup}")
    for path, theme in pending:
        print(f"{'Would update' if args.dry_run else 'Updated'} {path.name}: {len(theme['css'])} CSS characters")
    if not pending:
        print("No wallpaper themes need updating.")


if __name__ == "__main__":
    main()
