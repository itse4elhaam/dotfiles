#!/usr/bin/python3
"""Recover the personal GNOME/X11 desktop, or keep a Recover menu in the tray."""
import fcntl
from contextlib import contextmanager
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import struct
import select
import threading
from urllib.parse import urlparse
import time

STATE = Path.home() / '.local/state/desktop-recovery'
EDGE = 'microsoft-edge.Microsoft-edge'
ZOHO = 'crx__ilnnabaccafamopchccjobpmmpmdnope.Microsoft-edge'
WHATSAPP = 'crx__hnpfjngllnobngcgfapefoaidbinmjnm.Microsoft-edge'


def is_t3(window):
    return window['cls'].lower() in ('t3code.t3code', 'com.t3tools.t3code.com.t3tools.t3code')


def run(*args):
    return subprocess.check_output(args, text=True).strip()


def windows():
    return parse_windows(run('wmctrl', '-lxG'))


def parse_windows(output):
    result = []
    for line in output.splitlines():
        fields = line.split(None, 8)
        if len(fields) == 9:
            result.append(dict(id=fields[0], workspace=int(fields[1]),
                               x=int(fields[2]), y=int(fields[3]),
                               width=int(fields[4]), height=int(fields[5]),
                               cls=fields[6], title=fields[8]))
    return result


def monitors(output):
    result = []
    for line in output.splitlines()[1:]:
        match = re.search(r'(\d+)/\d+x(\d+)/\d+([+-]\d+)([+-]\d+)', line)
        if match:
            width, height, x, y = map(int, match.groups())
            result.append(dict(primary='*' in line.split()[1],
                               width=width, height=height, x=x, y=y))
    return sorted(result, key=lambda m: not m['primary'])


def edge_sessions(data):
    """Read Chromium SNSS commands, counting current URLs rather than history entries.

    Format: chromium/components/sessions/core/{session_service_commands,
    serialized_navigation_entry}.cc. Edge-only command IDs are ignored.
    """
    if len(data) < 8 or data[:4] != b'SNSS' or struct.unpack_from('<I', data, 4)[0] not in (1, 3):
        raise ValueError('Unsupported Edge session format')
    tabs, sessions = {}, {}
    offset = 8
    def tab(tid):
        return tabs.setdefault(tid, dict(window=None, index=-1, selected=0, nav={}))
    def window(wid):
        return sessions.setdefault(wid, dict(selected=0, workspace=None, kind=0))
    while offset + 2 <= len(data):
        size = struct.unpack_from('<H', data, offset)[0]
        offset += 2
        if size < 1 or offset + size > len(data):
            break  # The running browser can be halfway through appending a command.
        command, payload = data[offset], data[offset + 1:offset + size]
        offset += size
        if command in (0, 2, 7, 8, 9) and len(payload) >= 8:
            first, second = struct.unpack_from('<ii', payload)
            if command == 0:
                tab(second)['window'] = first
                window(first)
            elif command == 2:
                tab(first)['index'] = second
            elif command == 7:
                tab(first)['selected'] = second
            elif command == 8:
                window(first)['selected'] = second
            elif command == 9:
                window(first)['kind'] = second
        elif command == 6 and len(payload) >= 16:
            tid, index, length = struct.unpack_from('<iii', payload, 4)
            if length < 0 or 16 + length > len(payload):
                raise ValueError('Invalid Edge navigation record')
            url = payload[16:16 + length].decode('utf-8', errors='replace')
            pos = (16 + length + 3) & ~3
            title = ''
            if pos + 4 <= len(payload):
                characters = struct.unpack_from('<i', payload, pos)[0]
                if 0 <= characters <= (len(payload) - pos - 4) // 2:
                    title = payload[pos + 4:pos + 4 + characters * 2].decode('utf-16-le', errors='replace')
            tab(tid)['nav'][index] = (url, title)
        elif command in (16, 17) and len(payload) >= 4:
            identifier = struct.unpack_from('<i', payload)[0]
            if command == 16:
                tabs.pop(identifier, None)
            else:
                sessions.pop(identifier, None)
                tabs = {tid: t for tid, t in tabs.items() if t['window'] != identifier}
        elif command == 23 and len(payload) >= 12:
            wid, length = struct.unpack_from('<ii', payload, 4)
            value = payload[12:12 + max(length, 0)].decode('ascii', errors='replace')
            if value.isdigit():
                window(wid)['workspace'] = int(value)
        elif command in (5, 11, 24) and len(payload) >= (12 if command == 24 else 8):
            tid, index = struct.unpack_from('<ii', payload)
            nav = tab(tid)['nav']
            if command == 5:
                tab(tid)['nav'] = {i: n for i, n in nav.items() if i < index}
            else:
                start, count = (0, index) if command == 11 else (index, struct.unpack_from('<i', payload, 8)[0])
                tab(tid)['nav'] = {i if i < start else i - count: n
                                   for i, n in nav.items() if i < start or i >= start + count}
    result = []
    for wid, session in sessions.items():
        if session['kind'] != 0:
            continue
        members = [t for t in tabs.values() if t['window'] == wid and t['nav']]
        if not members:
            continue
        entries = [(t, t['nav'][min(t['nav'], key=lambda i: abs(i - t['selected']))]) for t in members]
        selected = next((entry for t, entry in entries if t['index'] == session['selected']), ('', ''))
        result.append(dict(workspace=session['workspace'], selected_title=selected[1],
                           titles=[entry[1] for _, entry in entries], tabs=len(entries),
                           upwork=sum((urlparse(entry[0]).hostname or '').lower().rstrip('.') in ('upwork.com', 'www.upwork.com')
                                      or (urlparse(entry[0]).hostname or '').lower().rstrip('.').endswith('.upwork.com')
                                      for _, entry in entries)))
    return result


def browser_workspaces(browser_windows, saved):
    available = list(saved)
    matches = []
    for window in browser_windows:
        def score(session):
            active = session['selected_title']
            return (int(bool(active) and active in window['title']) * 100
                    + int(any(title and title in window['title'] for title in session['titles'])) * 10
                    + int(session['workspace'] == window['workspace']))
        if not available or max(map(score, available)) == 0:
            raise RuntimeError('Cannot match Edge windows to saved tabs yet; try Recover again in a few seconds')
        match = max(available, key=score)
        available.remove(match)
        matches.append((window, match))
    # Ties preserve the reference workspace instead of swapping windows arbitrarily.
    main, _ = max(matches, key=lambda pair: (pair[1]['upwork'], pair[0]['workspace'] == 1))
    return {w['id']: 1 if w == main else 0 for w in browser_windows}


def saved_edge_sessions():
    directory = Path.home() / '.config/microsoft-edge/Default/Sessions'
    latest = max(directory.glob('Session_*'), default=None)
    if latest is None:
        raise RuntimeError('No Edge session to count tabs from')
    return edge_sessions(latest.read_bytes())


def launch(*command):
    # User services survive the shortcut process and keep application logs out of the terminal.
    subprocess.run(['systemd-run', '--user', '--collect', '--quiet',
                    '--unit=desktop-recovery-' + str(time.time_ns()), *command], check=True)


@contextmanager
def stage_windows(match, workspace, monitor):
    """Give new app windows a quiet workspace/display before the WM maps them.

    MapNotify is a fallback for apps that overwrite the initial X11 properties.
    No workspace activation or keyboard/pointer manipulation is involved.
    """
    from Xlib import X, Xatom, display, error
    connection = display.Display()
    root = connection.screen().root
    root.change_attributes(event_mask=X.SubstructureNotifyMask)
    connection.sync()
    stop = threading.Event()
    failures = []
    prepared, mapped = set(), set()
    user_time = connection.intern_atom('_NET_WM_USER_TIME')
    desktop = connection.intern_atom('_NET_WM_DESKTOP')

    def watch():
        try:
            while not stop.is_set():
                if not connection.pending_events():
                    select.select([connection.fileno()], [], [], 0.05)
                    continue
                event = connection.next_event()
                window = getattr(event, 'window', None)
                if window is None:
                    continue
                try:
                    if event.type == X.CreateNotify:
                        window.change_attributes(event_mask=X.PropertyChangeMask | X.StructureNotifyMask)
                    if event.type in (X.CreateNotify, X.PropertyNotify, X.MapNotify):
                        cls = window.get_wm_class()
                        if not cls or not match({'cls': '.'.join(cls)}):
                            continue
                        if window.id not in prepared:
                            window.change_property(user_time, Xatom.CARDINAL, 32, [0])
                            window.change_property(desktop, Xatom.CARDINAL, 32, [workspace])
                            window.configure(x=monitor['x'] + 40, y=monitor['y'] + 70,
                                             width=monitor['width'] - 80, height=monitor['height'] - 140)
                            prepared.add(window.id)
                        if event.type == X.MapNotify and window.id not in mapped:
                            mapped.add(window.id)
                            place({'id': hex(window.id)}, workspace, monitor)
                    connection.flush()
                except error.XError:
                    pass  # Splash windows can disappear before their properties are read.
        except Exception as failure:
            failures.append(failure)

    watcher = threading.Thread(target=watch, daemon=True)
    watcher.start()
    try:
        yield
    finally:
        stop.set()
        watcher.join()
        connection.close()
        if failures:
            raise RuntimeError('Could not stage new windows: ' + str(failures[0]))


def ensure_app(match, command, workspace, monitor, settle_seconds=2):
    if any(match(w) for w in windows()):
        return
    with stage_windows(match, workspace, monitor):
        launch(*command)
        deadline = time.monotonic() + 45
        previous, stable_since = None, time.monotonic()
        while time.monotonic() < deadline:
            current = sorted(w['id'] for w in windows() if match(w))
            if current != previous:
                previous, stable_since = current, time.monotonic()
            if current and time.monotonic() - stable_since >= settle_seconds:
                return
            time.sleep(0.1)
        raise RuntimeError('No settled window appeared for ' + command[0])


def backup_edge():
    source = Path.home() / '.config/microsoft-edge/Default/Sessions'
    if not source.exists():
        raise RuntimeError('Edge session directory is missing; refusing a blank recovery')
    destination = STATE / ('edge-session-' + time.strftime('%Y%m%d-%H%M%S'))
    shutil.copytree(source, destination)
    for old in sorted(STATE.glob('edge-session-*'))[:-5]:
        shutil.rmtree(old)


def place(window, workspace, monitor):
    wid = window['id']
    if workspace is not None:
        if window.get('workspace') == -1:
            subprocess.run(['wmctrl', '-ir', wid, '-b', 'remove,sticky'], check=True)
        if window.get('workspace') != workspace:
            subprocess.run(['wmctrl', '-ir', wid, '-t', str(workspace)], check=True)
    same_screen = ('x' in window
                   and monitor['x'] <= window['x'] + window['width'] / 2 < monitor['x'] + monitor['width']
                   and monitor['y'] <= window['y'] + window['height'] / 2 < monitor['y'] + monitor['height'])
    if not same_screen:
        subprocess.run(['wmctrl', '-ir', wid, '-b', 'remove,maximized_vert,maximized_horz'], check=True)
        geometry = f"0,{monitor['x'] + 40},{monitor['y'] + 70},{monitor['width'] - 80},{monitor['height'] - 140}"
        subprocess.run(['wmctrl', '-ir', wid, '-e', geometry], check=True)
    subprocess.run(['wmctrl', '-ir', wid, '-b', 'add,maximized_vert,maximized_horz'], check=True)


def notify(message):
    subprocess.run(['notify-send', 'Desktop recovery', message], check=False)


@contextmanager
def quiet_launches():
    schema = 'org.gnome.desktop.wm.preferences'
    original = run('gsettings', 'get', schema, 'focus-new-windows')
    subprocess.run(['gsettings', 'set', schema, 'focus-new-windows', 'strict'], check=True)
    try:
        yield
    finally:
        if run('gsettings', 'get', schema, 'focus-new-windows') == "'strict'":
            subprocess.run(['gsettings', 'set', schema, 'focus-new-windows', original], check=True)


def connect_earbuds():
    """Best effort only: do not scan, pair, or change the user's audio routing."""
    def bluetooth(*args):
        return subprocess.check_output(['bluetoothctl', '--timeout', '12', *args],
                                       text=True, timeout=15, stderr=subprocess.STDOUT)
    try:
        for line in bluetooth('paired-devices').splitlines():
            match = re.fullmatch(r'Device ([0-9A-Fa-f:]{17}) (.+)', line.strip())
            if match and match[2].casefold() == 'oneplus buds 4':
                address = match[1]
                if 'Connected: yes' in bluetooth('info', address):
                    return 'OnePlus Buds 4 connected.'
                bluetooth('connect', address)
                if 'Connected: yes' in bluetooth('info', address):
                    return 'OnePlus Buds 4 connected.'
                return 'OnePlus Buds 4 unavailable; reconnect from Bluetooth when ready.'
        return 'OnePlus Buds 4 are not paired.'
    except (OSError, subprocess.SubprocessError) as error:
        print(f'Earbuds connection skipped: {error}', file=sys.stderr)
        return 'OnePlus Buds 4 unavailable; reconnect from Bluetooth when ready.'


def recover():
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (STATE / 'recover.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            notify('Recovery is already running.')
            return
        if os.environ.get('XDG_SESSION_TYPE') != 'x11':
            raise RuntimeError('This layout requires the GNOME X11 session.')
        screens = monitors(run('xrandr', '--listmonitors'))
        if not screens:
            raise RuntimeError('No connected monitor found')
        if len(screens) > 1:
            # Both displays must participate in workspace switching for Ghostty/WhatsApp.
            subprocess.run(['gsettings', 'set', 'org.gnome.mutter',
                            'workspaces-only-on-primary', 'false'], check=True)
        subprocess.run(['gsettings', 'set', 'org.gnome.mutter', 'dynamic-workspaces', 'false'], check=True)
        count = len(run('wmctrl', '-d').splitlines())
        if count < 6:
            subprocess.run(['wmctrl', '-n', '6'], check=True)
        errors = []
        with quiet_launches():
            try:
                if not any(w['cls'] == EDGE for w in windows()):
                    backup_edge()
                    ensure_app(lambda w: w['cls'] == EDGE,
                               ['microsoft-edge', '--profile-directory=Default', '--restore-last-session'],
                               0, screens[-1], settle_seconds=5)
                browsers = [w for w in windows() if w['cls'] == EDGE]
                assignments = browser_workspaces(browsers, saved_edge_sessions()) if browsers else {}
                # Put workspace 1's Edge in place before opening any other application.
                for window in sorted(browsers, key=lambda w: assignments[w['id']]):
                    place(window, assignments[window['id']], screens[0])
            except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                errors.append(str(error))
            apps = [
                (lambda w: 'ghostty' in w['cls'].lower(),
                 ['ghostty', '-e', 'tmux', 'new-session', '-A', '-s', 'main'], 0, screens[-1]),
                (lambda w: w['cls'] == ZOHO,
                 ['gtk-launch', 'msedge-ilnnabaccafamopchccjobpmmpmdnope-Default'], 2, screens[0]),
                (lambda w: w['cls'].lower() == 'discord.discord', ['discord'], 3, screens[0]),
                (is_t3, ['gtk-launch', 't3code'], 4, screens[0]),
                (lambda w: w['cls'] == WHATSAPP,
                 ['gtk-launch', 'msedge-hnpfjngllnobngcgfapefoaidbinmjnm-Default'], 5, screens[-1]),
            ]
            for match, command, workspace, monitor in apps:
                try:
                    ensure_app(match, command, workspace, screens[-1])
                    for window in windows():
                        if match(window):
                            place(window, workspace, monitor)
                except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                    errors.append(str(error))
        # Let the last placement settle before asking Bluetooth to connect.
        time.sleep(2)
        earbuds = connect_earbuds()
        if errors:
            raise RuntimeError('; '.join(errors) + '. ' + earbuds)
        notify('Desktop ready. T3 Code is on workspace 5. ' + earbuds)



def tray():
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('AyatanaAppIndicator3', '0.1')
    from gi.repository import Gtk, AyatanaAppIndicator3
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock = (STATE / 'tray.lock').open('w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    indicator = AyatanaAppIndicator3.Indicator.new(
        'desktop-recovery', 'view-refresh', AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS)
    indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
    indicator.set_title('Desktop recovery')
    menu = Gtk.Menu()
    recover_item = Gtk.MenuItem(label='Recover')
    recover_item.connect('activate', lambda _: launch('/usr/bin/python3', str(Path(__file__).resolve()), 'recover'))
    menu.append(recover_item)
    quit_item = Gtk.MenuItem(label='Quit')
    quit_item.connect('activate', lambda _: Gtk.main_quit())
    menu.append(quit_item)
    menu.show_all()
    indicator.set_menu(menu)
    Gtk.main()


if __name__ == '__main__':
    try:
        if sys.argv[1:] == ['tray']:
            tray()
        else:
            recover()
    except Exception as error:
        print(f'Desktop recovery failed: {error}', file=sys.stderr)
        notify(f'Recovery incomplete: {error}. See journalctl --user -g desktop-recovery')
        sys.exit(1)
