#!/usr/bin/python3
"""Recover the personal GNOME/X11 desktop, or keep a Recover menu in the tray."""
import fcntl
from contextlib import contextmanager
import hashlib
import logging
from logging.handlers import RotatingFileHandler
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import struct
import select
import threading
import time

STATE = Path.home() / '.local/state/desktop-recovery'
LOG = logging.getLogger('desktop-recovery')
EDGE = 'microsoft-edge.Microsoft-edge'
ZOHO = 'crx__ilnnabaccafamopchccjobpmmpmdnope.Microsoft-edge'
WHATSAPP = 'crx__hnpfjngllnobngcgfapefoaidbinmjnm.Microsoft-edge'


def is_t3(window):
    return window['cls'].lower() in ('t3code.t3code', 'com.t3tools.t3code.com.t3tools.t3code')


def run(*args):
    return subprocess.check_output(args, text=True, timeout=5).strip()


def windows():
    return parse_windows(run('wmctrl', '-lxG'))


def parse_windows(output):
    result = []
    for line in output.splitlines():
        fields = line.split(None, 8)
        if len(fields) == 9:
            result.append(dict(id=fields[0], workspace=int(fields[1]),
                               x=int(fields[2]), y=int(fields[3]),
                               width=int(fields[4]), height=int(fields[5]),
                               cls=fields[6], title=fields[8]))
    return result


def monitors(output):
    result = []
    for line in output.splitlines()[1:]:
        match = re.search(r'(\d+)/\d+x(\d+)/\d+([+-]\d+)([+-]\d+)', line)
        if match:
            width, height, x, y = map(int, match.groups())
            result.append(dict(primary='*' in line.split()[1],
                               width=width, height=height, x=x, y=y))
    return sorted(result, key=lambda m: not m['primary'])


def edge_sessions(data):
    """Read Chromium SNSS window and current-tab metadata.

    Format: chromium/components/sessions/core/{session_service_commands,
    serialized_navigation_entry}.cc. Edge-only command IDs are ignored.
    """
    if len(data) < 8 or data[:4] != b'SNSS' or struct.unpack_from('<I', data, 4)[0] not in (1, 3):
        raise ValueError('Unsupported Edge session format')
    tabs, sessions = {}, {}
    offset = 8
    def tab(tid):
        return tabs.setdefault(tid, dict(window=None, index=-1, selected=0, nav={}))
    def window(wid):
        return sessions.setdefault(wid, dict(selected=0, workspace=None, kind=0))
    while offset + 2 <= len(data):
        size = struct.unpack_from('<H', data, offset)[0]
        offset += 2
        if size < 1 or offset + size > len(data):
            break  # The running browser can be halfway through appending a command.
        command, payload = data[offset], data[offset + 1:offset + size]
        offset += size
        if command in (0, 2, 7, 8, 9) and len(payload) >= 8:
            first, second = struct.unpack_from('<ii', payload)
            if command == 0:
                tab(second)['window'] = first
                window(first)
            elif command == 2:
                tab(first)['index'] = second
            elif command == 7:
                tab(first)['selected'] = second
            elif command == 8:
                window(first)['selected'] = second
            elif command == 9:
                window(first)['kind'] = second
        elif command == 6 and len(payload) >= 16:
            tid, index, length = struct.unpack_from('<iii', payload, 4)
            if length < 0 or 16 + length > len(payload):
                raise ValueError('Invalid Edge navigation record')
            pos = (16 + length + 3) & ~3
            title = ''
            if pos + 4 <= len(payload):
                characters = struct.unpack_from('<i', payload, pos)[0]
                if 0 <= characters <= (len(payload) - pos - 4) // 2:
                    title = payload[pos + 4:pos + 4 + characters * 2].decode('utf-16-le', errors='replace')
            tab(tid)['nav'][index] = title
        elif command in (16, 17) and len(payload) >= 4:
            identifier = struct.unpack_from('<i', payload)[0]
            if command == 16:
                tabs.pop(identifier, None)
            else:
                sessions.pop(identifier, None)
                tabs = {tid: t for tid, t in tabs.items() if t['window'] != identifier}
        elif command == 23 and len(payload) >= 12:
            wid, length = struct.unpack_from('<ii', payload, 4)
            value = payload[12:12 + max(length, 0)].decode('ascii', errors='replace')
            if value.isdigit():
                window(wid)['workspace'] = int(value)
        elif command in (5, 11, 24) and len(payload) >= (12 if command == 24 else 8):
            tid, index = struct.unpack_from('<ii', payload)
            nav = tab(tid)['nav']
            if command == 5:
                tab(tid)['nav'] = {i: n for i, n in nav.items() if i < index}
            else:
                start, count = (0, index) if command == 11 else (index, struct.unpack_from('<i', payload, 8)[0])
                tab(tid)['nav'] = {i if i < start else i - count: n
                                   for i, n in nav.items() if i < start or i >= start + count}
    result = []
    for wid, session in sessions.items():
        if session['kind'] != 0:
            continue
        members = [t for t in tabs.values() if t['window'] == wid and t['nav']]
        if not members:
            continue
        entries = [(t, t['nav'][min(t['nav'], key=lambda i: abs(i - t['selected']))]) for t in members]
        selected = next((entry for t, entry in entries if t['index'] == session['selected']), '')
        result.append(dict(workspace=session['workspace'], selected_title=selected, tabs=len(entries)))
    return result


def restored_workspaces(browser_windows, saved):
    """Keep native placement when it already matches the saved workspace set."""
    expected = sorted(session['workspace'] for session in saved if session['workspace'] is not None)
    if len(expected) != len(saved):
        return {}
    if sorted(window['workspace'] for window in browser_windows) == expected:
        return {}
    assignments = {}
    for window in browser_windows:
        candidates = [session for session in saved if session['selected_title']
                      and session['selected_title'] in window['title']]
        if len(candidates) != 1:
            return None
        assignments[window['id']] = candidates[0]['workspace']
    return assignments if sorted(assignments.values()) == expected else None


def saved_edge_sessions():
    directory = Path.home() / '.config/microsoft-edge/Default/Sessions'
    latest = max(directory.glob('Session_*'), default=None)
    if latest is None:
        raise RuntimeError('No Edge session to count tabs from')
    return edge_sessions(latest.read_bytes())


def launch(*command):
    unit = f'desktop-recovery-{time.time_ns()}.service'
    LOG.info('event=launch unit=%s executable=%s', unit, Path(command[0]).name)
    subprocess.run(['systemd-run', '--user', '--collect', '--quiet',
                    '--property=Type=exec',
                    '--unit=' + unit, *command], check=True, timeout=10)
    return unit


@contextmanager
def stage_windows(match, workspace, monitor):
    """Give new app windows a quiet workspace/display before the WM maps them.

    MapNotify is a fallback for apps that overwrite the initial X11 properties.
    No workspace activation or keyboard/pointer manipulation is involved.
    """
    from Xlib import X, Xatom, display, error
    connection = display.Display()
    root = connection.screen().root
    root.change_attributes(event_mask=X.SubstructureNotifyMask)
    connection.sync()
    stop = threading.Event()
    failures = []
    prepared, mapped = set(), set()
    user_time = connection.intern_atom('_NET_WM_USER_TIME')
    desktop = connection.intern_atom('_NET_WM_DESKTOP')

    def watch():
        try:
            while not stop.is_set():
                if not connection.pending_events():
                    select.select([connection.fileno()], [], [], 0.05)
                    continue
                event = connection.next_event()
                window = getattr(event, 'window', None)
                if window is None:
                    continue
                try:
                    if event.type == X.CreateNotify:
                        window.change_attributes(event_mask=X.PropertyChangeMask | X.StructureNotifyMask)
                    if event.type in (X.CreateNotify, X.PropertyNotify, X.MapNotify):
                        cls = window.get_wm_class()
                        if not cls or not match({'cls': '.'.join(cls)}):
                            continue
                        if window.id not in prepared:
                            window.change_property(user_time, Xatom.CARDINAL, 32, [0])
                            window.change_property(desktop, Xatom.CARDINAL, 32, [workspace])
                            window.configure(x=monitor['x'] + 40, y=monitor['y'] + 70,
                                             width=monitor['width'] - 80, height=monitor['height'] - 140)
                            prepared.add(window.id)
                        if event.type == X.MapNotify and window.id not in mapped:
                            mapped.add(window.id)
                            place({'id': hex(window.id)}, workspace, monitor)
                    connection.flush()
                except error.XError:
                    pass  # Splash windows can disappear before their properties are read.
        except Exception as failure:
            failures.append(failure)

    watcher = threading.Thread(target=watch, daemon=True)
    watcher.start()
    try:
        yield
    finally:
        stop.set()
        watcher.join()
        connection.close()
        if failures:
            raise RuntimeError('Could not stage new windows: ' + str(failures[0]))


def wait_for_windows(match, settle_seconds, ready, timeout):
    deadline = time.monotonic() + timeout
    previous = None
    while time.monotonic() < deadline:
        current = sorted((w for w in windows() if match(w)), key=lambda w: w['id'])
        if current != previous:
            previous, stable_since = current, time.monotonic()
        if current and time.monotonic() - stable_since >= settle_seconds and ready(current):
            return current
        time.sleep(0.2)
    raise RuntimeError(f'window_timeout observed={len(previous or [])} timeout_seconds={timeout}')


def ensure_app(match, command, workspace, monitor):
    existing = [w for w in windows() if match(w)]
    if existing:
        LOG.info('event=reuse windows=%d', len(existing))
        return existing
    with stage_windows(match, workspace, monitor):
        launch(*command)
        return wait_for_windows(match, 0.8, lambda _: True, 18)


def recover_edge():
    match = lambda w: w['cls'].casefold() == EDGE.casefold()
    existing = any(match(w) for w in windows())
    saved = saved_edge_sessions()
    if not saved:
        raise RuntimeError('no_saved_browser_windows')
    LOG.info('event=edge_snapshot expected_windows=%d saved_tabs=%d existing=%s',
             len(saved), sum(session['tabs'] for session in saved), existing)
    if not existing:
        backup_edge()
        launch('microsoft-edge', '--profile-directory=Default', '--restore-last-session')
    assignments = {}

    def ready(current):
        nonlocal assignments
        if len(current) < len(saved):
            return False
        if existing:
            return True
        if len(current) != len(saved):
            return False
        assignments = restored_workspaces(current, saved)
        return assignments is not None

    settled = wait_for_windows(match, 2 if existing else 5, ready, 60)
    if assignments:
        for window in settled:
            workspace = assignments[window['id']]
            if workspace != window['workspace']:
                subprocess.run(['wmctrl', '-ir', window['id'], '-t', str(workspace)],
                               check=True, timeout=5)
        settled = wait_for_windows(match, 2, lambda current: len(current) == len(saved)
                                   and all(assignments.get(w['id']) == w['workspace'] for w in current), 15)
    LOG.info('event=edge_settled windows=%d workspaces=%s', len(settled),
             ','.join(str(w['workspace'] + 1) for w in settled))


def backup_edge():
    source = Path.home() / '.config/microsoft-edge/Default/Sessions'
    if not source.exists():
        raise RuntimeError('Edge session directory is missing; refusing a blank recovery')
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    destination = STATE / ('edge-session-' + time.strftime('%Y%m%d-%H%M%S'))
    shutil.copytree(source, destination)
    for old in sorted(STATE.glob('edge-session-*'))[:-5]:
        shutil.rmtree(old)


def place(window, workspace, monitor):
    wid = window['id']
    if workspace is not None:
        if window.get('workspace') == -1:
            subprocess.run(['wmctrl', '-ir', wid, '-b', 'remove,sticky'], check=True, timeout=5)
        if window.get('workspace') != workspace:
            subprocess.run(['wmctrl', '-ir', wid, '-t', str(workspace)], check=True, timeout=5)
    same_screen = ('x' in window
                   and monitor['x'] <= window['x'] + window['width'] / 2 < monitor['x'] + monitor['width']
                   and monitor['y'] <= window['y'] + window['height'] / 2 < monitor['y'] + monitor['height'])
    if not same_screen:
        subprocess.run(['wmctrl', '-ir', wid, '-b', 'remove,maximized_vert,maximized_horz'], check=True, timeout=5)
        geometry = f"0,{monitor['x'] + 40},{monitor['y'] + 70},{monitor['width'] - 80},{monitor['height'] - 140}"
        subprocess.run(['wmctrl', '-ir', wid, '-e', geometry], check=True, timeout=5)
    subprocess.run(['wmctrl', '-ir', wid, '-b', 'add,maximized_vert,maximized_horz'], check=True, timeout=5)


def notify(message):
    try:
        subprocess.run(['notify-send', 'Desktop recovery', message], check=True, timeout=5)
    except (OSError, subprocess.SubprocessError) as error:
        LOG.warning('event=notification_failed error=%s', type(error).__name__)


@contextmanager
def quiet_launches():
    schema = 'org.gnome.desktop.wm.preferences'
    original = run('gsettings', 'get', schema, 'focus-new-windows')
    subprocess.run(['gsettings', 'set', schema, 'focus-new-windows', 'strict'], check=True, timeout=5)
    try:
        yield
    finally:
        if run('gsettings', 'get', schema, 'focus-new-windows') == "'strict'":
            subprocess.run(['gsettings', 'set', schema, 'focus-new-windows', original], check=True, timeout=5)


def connect_earbuds():
    """Best effort only: do not scan, pair, or change the user's audio routing."""
    def bluetooth(*args):
        return subprocess.check_output(['bluetoothctl', '--timeout', '12', *args],
                                       text=True, timeout=15, stderr=subprocess.STDOUT)
    try:
        for line in bluetooth('paired-devices').splitlines():
            match = re.fullmatch(r'Device ([0-9A-Fa-f:]{17}) (.+)', line.strip())
            if match and match[2].casefold() == 'oneplus buds 4':
                address = match[1]
                if 'Connected: yes' in bluetooth('info', address):
                    return 'OnePlus Buds 4 connected.'
                bluetooth('connect', address)
                if 'Connected: yes' in bluetooth('info', address):
                    return 'OnePlus Buds 4 connected.'
                return 'OnePlus Buds 4 unavailable; reconnect from Bluetooth when ready.'
        return 'OnePlus Buds 4 are not paired.'
    except (OSError, subprocess.SubprocessError) as error:
        print(f'Earbuds connection skipped: {error}', file=sys.stderr)
        return 'OnePlus Buds 4 unavailable; reconnect from Bluetooth when ready.'


def configure_logging():
    run_id = str(time.time_ns())
    formatter = logging.Formatter(
        f'%(asctime)s %(levelname)s run={run_id} %(message)s', datefmt='%Y-%m-%dT%H:%M:%S%z')
    LOG.setLevel(logging.INFO)
    stderr = logging.StreamHandler()
    stderr.setFormatter(formatter)
    LOG.addHandler(stderr)


def enable_file_logging():
    formatter = LOG.handlers[0].formatter
    try:
        STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
        for path in STATE.glob('recovery.log.[1-3]'):
            if time.time() - path.stat().st_mtime > 14 * 86400:
                path.unlink()
        log_path = STATE / 'recovery.log'
        if log_path.exists() and time.time() - log_path.stat().st_mtime > 14 * 86400:
            log_path.unlink()
        handler = RotatingFileHandler(log_path, maxBytes=128 * 1024, backupCount=3,
                                      encoding='utf-8')
        log_path.chmod(0o600)
        handler.setFormatter(formatter)
        LOG.addHandler(handler)
    except OSError:
        LOG.warning('event=log_storage_unavailable')


def pwa(app_id):
    return ['microsoft-edge', '--profile-directory=Default', '--app-id=' + app_id]


def recover():
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR') or STATE)
    runtime.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (runtime / 'desktop-recovery.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            LOG.info('event=already_running')
            notify('Recovery is already running.')
            return
        if LOG.handlers:
            enable_file_logging()
        LOG.info('event=start revision=%s', hashlib.sha256(Path(__file__).read_bytes()).hexdigest()[:12])
        if os.environ.get('XDG_SESSION_TYPE') != 'x11':
            raise RuntimeError('This layout requires the GNOME X11 session.')
        screens = monitors(run('xrandr', '--listmonitors'))
        if not screens:
            raise RuntimeError('No connected monitor found')
        if len(screens) > 1:
            subprocess.run(['gsettings', 'set', 'org.gnome.mutter',
                            'workspaces-only-on-primary', 'false'], check=True, timeout=5)
        subprocess.run(['gsettings', 'set', 'org.gnome.mutter', 'dynamic-workspaces', 'false'],
                       check=True, timeout=5)
        count = len(run('wmctrl', '-d').splitlines())
        if count < 6:
            subprocess.run(['wmctrl', '-n', '6'], check=True, timeout=5)
        failures = []
        with quiet_launches():
            LOG.info('event=stage_start app=Edge')
            try:
                recover_edge()
            except Exception as error:
                log_failure('Edge', error)
                LOG.warning('event=remaining_apps_skipped reason=edge_gate')
                raise RuntimeError('Edge restore incomplete. Check Edge, then retry Recover.') from error
            apps = [
                ('T3 Code', is_t3, [str(Path.home() / '.local/bin/t3'), '--foreground'], 0, screens[0]),
                ('Ghostty', lambda w: 'ghostty' in w['cls'].lower(),
                 ['ghostty', '-e', 'tmux', 'new-session', '-A', '-s', 'main'], 3, screens[-1]),
                ('Discord', lambda w: w['cls'].lower() == 'discord.discord', ['discord'], 4, screens[0]),
                ('Zoho Mail', lambda w: w['cls'] == ZOHO, pwa('ilnnabaccafamopchccjobpmmpmdnope'), 4, screens[0]),
                ('WhatsApp', lambda w: w['cls'] == WHATSAPP, pwa('hnpfjngllnobngcgfapefoaidbinmjnm'), 5, screens[-1]),
            ]
            for app, match, command, workspace, monitor in apps:
                start = time.monotonic()
                LOG.info('event=stage_start app=%s workspace=%d', app, workspace + 1)
                try:
                    current = ensure_app(match, command, workspace, monitor)
                    for window in current:
                        place(window, workspace, monitor)
                    wait_for_windows(match, 0.4, lambda found: all(
                        w['workspace'] == workspace for w in found), 5)
                    LOG.info('event=stage_complete app=%s windows=%d elapsed_ms=%d',
                             app, len(current), (time.monotonic() - start) * 1000)
                except Exception as error:
                    log_failure(app, error)
                    failures.append(app)
        earbuds = connect_earbuds()
        LOG.info('event=earbuds result=%s', earbuds)
        if failures:
            raise RuntimeError('Could not recover: ' + ', '.join(failures))
        LOG.info('event=complete')
        notify('Desktop ready. T3 Code is on workspace 1. ' + earbuds)


def log_failure(app, error):
    detail = str(error) if str(error).startswith('window_timeout ') else ''
    LOG.error('event=stage_failed app=%s error=%s errno=%s exit=%s %s', app,
              type(error).__name__, getattr(error, 'errno', None),
              getattr(error, 'returncode', None), detail)


def tray():
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('AyatanaAppIndicator3', '0.1')
    from gi.repository import Gtk, AyatanaAppIndicator3
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock = (STATE / 'tray.lock').open('w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    indicator = AyatanaAppIndicator3.Indicator.new(
        'desktop-recovery', 'view-refresh', AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS)
    indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
    indicator.set_title('Desktop recovery')
    menu = Gtk.Menu()
    recover_item = Gtk.MenuItem(label='Recover')
    recover_item.connect('activate', lambda _: launch('/usr/bin/python3', str(Path(__file__).resolve()), 'recover'))
    menu.append(recover_item)
    quit_item = Gtk.MenuItem(label='Quit')
    quit_item.connect('activate', lambda _: Gtk.main_quit())
    menu.append(quit_item)
    menu.show_all()
    indicator.set_menu(menu)
    Gtk.main()


if __name__ == '__main__':
    try:
        if sys.argv[1:] == ['tray']:
            tray()
        else:
            configure_logging()
            recover()
    except KeyboardInterrupt:
        LOG.warning('event=cancelled')
        sys.exit(130)
    except Exception as error:
        LOG.error('event=failed error=%s', type(error).__name__)
        message = str(error) if type(error) is RuntimeError else type(error).__name__
        notify(f'Recovery incomplete: {message} See ~/.local/state/desktop-recovery/recovery.log')
        sys.exit(1)
