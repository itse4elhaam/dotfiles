[Unit]
Description=Double-tap Ctrl for T3 Code voice dictation
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=NO_AT_BRIDGE=1
ExecStart=/usr/bin/python3 -I %h/.local/bin/t3-double-ctrl
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
