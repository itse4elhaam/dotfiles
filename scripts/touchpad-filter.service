[Unit]
Description=ELAN touchpad filter (opt-in; bridges dead-band drops, holds short ghost contacts)
Documentation=file:/home/elhaam/dotfiles/docs/touchpad-recovery.md
After=systemd-udevd.service
# No [Install] section: nothing starts this at boot. `touchpad-filter on` starts it.

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -I /usr/local/libexec/touchpad-filter.py --run
# Any exit leaves the touchpad unfiltered: the kernel drops the grab when the
# process's descriptors close. Never restart on its own.
Restart=no
# Internal 1 s kernel timer is the primary stall guard; this is the backup.
WatchdogSec=2s
TimeoutStartSec=20s
TimeoutStopSec=5s
Nice=-10
RuntimeDirectory=touchpad-filter
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022

# Root only for file ownership of /dev/input/event* and /dev/uinput; no capabilities.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
DevicePolicy=closed
# The event node number changes on every driver rebind, so allow the input class read-only.
DeviceAllow=char-input r
DeviceAllow=/dev/uinput rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=128M
TasksMax=4
