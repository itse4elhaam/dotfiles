[Unit]
Description=Outage-aware battery reminders and touchpad ghost alerts (notify-only)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /home/elhaam/dotfiles/scripts/touchpad-notify
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
