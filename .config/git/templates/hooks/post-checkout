#!/bin/bash
set -euo pipefail

# New worktrees and clones have a null old HEAD. The helper rules out clones.
[[ $# == 3 && "$3" == 1 ]] || exit 0
case "$1" in
  ''|*[!0]*) exit 0 ;;
esac

# Leaving an unborn orphan branch also reports a null old HEAD.
case "$(git reflog -1 --format=%gs HEAD 2>/dev/null || true)" in
  checkout:*) exit 0 ;;
esac

helper="$HOME/dotfiles/scripts/worktree-deps"
if [[ -x "$helper" ]]; then
  "$helper" checkout
fi
