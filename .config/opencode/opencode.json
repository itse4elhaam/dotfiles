{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "tmux kill-server": "deny",
      "git push --force": "ask",
      "git push -f": "ask",
      "rm -rf /": "deny",
      "rm -rf /home/elhaam/dotfiles": "deny",
      "git reset --hard": "deny",
      "*build": "ask",
      "gh pr merge*": "ask"
    },
    "linear_*": "deny",
    "linear_fetch": "allow",
    "linear_get_*": "allow",
    "linear_list_*": "allow",
    "linear_search*": "allow",
    "linear_extract_images": "allow"
  },
  "autoupdate": false,
  "lsp": {
    "typescript": {
      "disabled": true
    },
    "tsgo": {
      "command": [
        "tsgo",
        "--lsp",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "linear-mcp-server"
      ],
      "environment": {
        "LINEAR_API_KEY": "{env:LINEAR_API_KEY}"
      },
      "timeout": 30000,
      "enabled": true,
    }
  },
  "plugin": [
    "oh-my-openagent",
    "opencode-supermemory@latest",
    "opencode-pty",
    "@koriit/opencode-tmux-window-status"
  ],
  "provider": {
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": {
          "variants": {
            "fast": {
              "thinking": {
                "type": "disabled"
              }
            }
          }
        }
      }
    }
  }
}
