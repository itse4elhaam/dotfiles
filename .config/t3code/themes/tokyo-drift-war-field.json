  "css": ".dark{--td-wallpaper:url(\"data:image/avif;base64,\");--td-shade:.73}.dark [data-slot=sidebar-wrapper]{background:#0000!important}.dark body{background:linear-gradient(rgb(26 27 38/var(--td-shade)),rgb(26 27 38/.78)) fixed,var(--td-wallpaper) center/cover no-repeat fixed!important}.dark [data-slot=sidebar-inset],.dark [data-slot=sidebar-inset]>div:has([data-workspace-area=conversation]),.dark [data-workspace-area=conversation],.dark .messages-timeline-scroll{background:#0000!important}.dark [data-slot=composer-host]{background:linear-gradient(180deg,#ffffff0d,#ffffff03),rgb(26 27 38/.48)!important;backdrop-filter:blur(24px) saturate(1.5);border:1px solid #ffffff0a!important;box-shadow:inset 0 1px 0 #ffffff0f,0 10px 36px #00000026}.dark [data-chat-composer-form],.dark [data-slot=composer-context-strip]{background:#0000!important}.dark [data-user-message-bubble],.dark [data-thread-details-card]{background:linear-gradient(180deg,#ffffff0a,#0000),rgb(31 35 54/.50)!important;backdrop-filter:blur(18px) saturate(1.4);box-shadow:inset 0 1px 0 #ffffff0d;border:1px solid #ffffff0a!important}.dark [data-slot=dialog-popup],.dark [data-slot=popover-popup],.dark [data-slot=menu-popup]{background:linear-gradient(#ffffff0f,#ffffff03 50%),#1a1b268f!important;backdrop-filter:blur(28px) saturate(1.6);box-shadow:inset 0 1px #ffffff12,0 16px 48px #0000004d!important;border-color:#ffffff0a!important}.dark .chat-markdown-codeblock{background:#1a1b26!important;border:1px solid #ffffff0a;border-radius:12px!important}.dark [data-slot=button],.dark [data-slot=input],.dark [data-slot=select-trigger]{border-radius:8px!important}.dark [data-slot=composer-host],.dark [data-user-message-bubble],.dark [data-thread-details-card],.dark [data-slot=dialog-popup],.dark [data-slot=popover-popup],.dark [data-slot=menu-popup]{border-radius:16px!important}@media (hover:hover) and (pointer:fine){[data-message-role]{--td-a:0}[data-message-role]:is(:hover,:focus-within){--td-a:1}[data-message-role] button:is([aria-label=\"Copy message\"],[aria-label=\"Copy response\"],[aria-label=\"Fork from this response\"],[aria-label=\"Reply to this response\"],[aria-label=\"Edit from here\"]){opacity:var(--td-a)!important}}.dark [data-slot=popover-popup] [class*=bg-card]{background:none!important}\n/* t3-wallpaper-layout */\n.dark [data-timeline-loading],.dark :is([data-slot=sidebar-inset] *,[data-slot=sheet-popup],[data-side-chat-pane] *):has([data-chat-composer-form]):not([data-slot=composer-host],[data-slot=composer-host] *,[data-preview-panel-mode]){background:#0000!important}  .dark [data-chat-header]{background:rgb(26 27 38/.57)!important;backdrop-filter:blur(12px)}  [data-workspace-area=pull-requests] .max-w-6xl{max-width:none!important}  .dark :is([data-slot=sidebar-inner],[data-slot=sidebar][data-mobile],[data-preview-panel-mode]:has([data-side-chat-pane])){background:linear-gradient(135deg,#ffffff26,#ffffff05 42%,#ffffff12),#16161e38!important;backdrop-filter:blur(28px) saturate(1.8);box-shadow:inset 0 1px #ffffff20,inset -1px 0 #ffffff08,0 8px 32px #0003}  .dark [data-sidebar=trigger]{background:#0000!important;backdrop-filter:none;box-shadow:none;border-color:transparent;border-radius:0!important;opacity:.5}.dark [data-sidebar=trigger]:is(:hover,:focus-visible){opacity:1}  [data-slot=sheet-popup]:has(>[data-preview-panel-mode=sheet]){margin-top:0!important;height:100%!important;max-height:100%!important}\n"
