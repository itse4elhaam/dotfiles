  "css": ".dark{--td-wallpaper:url(\"data:image/avif;base64,\");--td-shade:.80;}.dark [data-slot=sidebar-wrapper]{isolation:isolate;background:transparent!important;}.dark [data-slot=sidebar-wrapper]::before{content:\"\";position:fixed;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(rgba(26,27,38,var(--td-shade)),rgba(26,27,38,.84)),var(--td-wallpaper);background-position:center;background-size:cover;background-repeat:no-repeat;}.dark [data-slot=sidebar-inset],.dark [data-slot=sidebar-inset]>div:has([data-workspace-area=conversation]),.dark [data-workspace-area=conversation],.dark .messages-timeline-scroll{background:transparent!important;}.dark [data-slot=composer-host]{background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.01)),rgba(26,27,38,.48)!important;backdrop-filter:blur(24px) saturate(1.5);border:1px solid #ffffff0a!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 10px 36px #00000026;}.dark [data-chat-composer-form],.dark [data-slot=composer-context-strip]{background:transparent!important;}.dark [data-user-message-bubble],.dark [data-thread-details-card]{background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,0)),rgba(31,35,54,.50)!important;backdrop-filter:blur(18px) saturate(1.4);box-shadow:inset 0 1px 0 rgba(255,255,255,.05);border:1px solid #ffffff0a!important;}.dark [data-slot=dialog-popup],.dark [data-slot=popover-popup],.dark [data-slot=menu-popup]{background:linear-gradient(180deg,#ffffff0f,#ffffff03 50%),rgba(26,27,38,.56)!important;backdrop-filter:blur(28px) saturate(1.6);box-shadow:inset 0 1px 0 #ffffff12,0 16px 48px #0000004d!important;border-color:#ffffff0a!important;}.dark .chat-markdown-codeblock{background:#1a1b26!important;border:1px solid #ffffff0a;border-radius:12px!important;}.dark [data-slot=button],.dark [data-slot=input],.dark [data-slot=select-trigger]{border-radius:8px!important;}.dark [data-slot=composer-host],.dark [data-user-message-bubble],.dark [data-thread-details-card],.dark [data-slot=dialog-popup],.dark [data-slot=popover-popup],.dark [data-slot=menu-popup]{border-radius:16px!important;}@media (hover:hover) and (pointer:fine){[data-message-role]{--td-action-opacity:0}[data-message-role]:is(:hover,:focus-within){--td-action-opacity:1}[data-message-role] button:is([aria-label=\"Copy message\"],[aria-label=\"Copy response\"],[aria-label=\"Fork from this response\"],[aria-label=\"Reply to this response\"],[aria-label=\"Edit from here\"]){opacity:var(--td-action-opacity)!important}}.dark [data-slot=popover-popup] :is([data-slot=card],[class*=bg-card],[class*=bg-popover]){background:transparent!important;border-color:#ffffff0a!important;}\n/* t3-wallpaper-layout */\n.dark [data-workspace-area=conversation] > [data-timeline-loading],.dark [data-slot=sidebar-inset] :has([data-chat-composer-form]):not([data-slot=composer-host]):not([data-slot=composer-host] *){background: transparent!important;}  .dark [data-chat-header]{background: rgba(26,27,38,.57)!important;backdrop-filter: blur(12px);}  [data-workspace-area=pull-requests] .max-w-6xl{max-width: none!important;}  .dark :is([data-slot=sidebar-inner],[data-slot=sidebar][data-mobile]){background: linear-gradient(135deg,#ffffff26,#ffffff05 42%,#ffffff12),#16161e38!important;backdrop-filter: blur(28px) saturate(1.8);box-shadow: inset 0 1px #ffffff20,inset -1px 0 #ffffff08,0 8px 32px #0003;border-right: 1px solid #ffffff0a;}.dark [data-sidebar=trigger]{background: linear-gradient(155deg,#ffffff38,#ffffff08 50%,#ffffff18),#16161e40!important;backdrop-filter: blur(20px) saturate(1.8);box-shadow: inset 0 1px #ffffff40,0 4px 16px #0003;border: 1px solid #ffffff12;border-radius: 10px;}\n"
