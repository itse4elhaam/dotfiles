{
  "name": "opencode-selfmod",
  "version": "0.1.0",
  "description": "Safe, proposal-gated self-modification plugin for OpenCode — validate before you mutate",
  "type": "module",
  "license": "MIT",
  "author": "",
  "packageManager": "bun@1.2.20",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itse4elhaam/opencode-selfmod.git"
  },
  "keywords": [
    "opencode",
    "plugin",
    "self-modification",
    "self-improvement",
    "self-reflection",
    "agent"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "agent",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.3.15",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  }
}
