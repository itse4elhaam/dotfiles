{
  "manifest_version": 3,
  "name": "Arm field for desktop dictation",
  "version": "1.0",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Arm the focused field for one dictation"
  },
  "background": {
    "service_worker": "arm.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      }
    }
  }
}
