{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "meta+o": "chat:newline",
        "ctrl+x e": "chat:externalEditor",
        "meta+l": "chat:modelPicker",
        "meta+h": "chat:modelPicker",
        "ctrl+j": null
      }
    },
    {
      "context": "Scroll",
      "bindings": {
        "meta+j": "scroll:halfPageDown",
        "meta+k": "scroll:halfPageUp",
        "ctrl+j": "scroll:halfPageDown",
        "ctrl+k": "scroll:halfPageUp"
      }
    },
    {
      "context": "Transcript",
      "bindings": {
        "meta+j": "scroll:halfPageDown",
        "meta+k": "scroll:halfPageUp",
        "ctrl+j": "scroll:halfPageDown",
        "ctrl+k": "scroll:halfPageUp"
      }
    }
  ]
}
